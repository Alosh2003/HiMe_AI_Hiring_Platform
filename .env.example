# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/hime_ai

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ─── LLM Provider: gemini | openai | none ───────────────────────────────────
LLM_PROVIDER=gemini

# Google AI Studio: https://aistudio.google.com/app/apikey (free tier, no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI: https://platform.openai.com/api-keys (requires payment method)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Storage ────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated origins for production, e.g. https://hime.ai,https://www.hime.ai
CORS_ORIGIN=*

# ─── Frontend ───────────────────────────────────────────────────────────────
# Shown on the API root route so you know which port serves the UI
FRONTEND_URL=http://localhost:3000
