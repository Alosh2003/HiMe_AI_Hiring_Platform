# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/hime_ai

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ─── LLM Provider: gemini | openai | ollama | none ───────────────────────────
LLM_PROVIDER=gemini

# Optional second chance when the primary fails (e.g. ollama down → gemini).
# Defaults to "gemini" automatically when the primary is ollama and a
# GEMINI_API_KEY is present, so leaving this empty is usually right.
LLM_FALLBACK=

# Google AI Studio: https://aistudio.google.com/app/apikey (free tier, no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI: https://platform.openai.com/api-keys (requires payment method)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama: local models, no key and no quota. Install from
# https://ollama.com/download, then e.g. `ollama pull qwen2.5:7b`.
# The API server must be able to reach the Ollama service.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ─── Storage ────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated origins for production, e.g. https://hime.ai,https://www.hime.ai
CORS_ORIGIN=*

# ─── Frontend ───────────────────────────────────────────────────────────────
# Shown on the API root route so you know which port serves the UI
FRONTEND_URL=http://localhost:3000

# ─── Email delivery ────────────────────────────────────────────────────────
# "log" (the only provider wired so far) stores every outbound email in the
# email_outbox table and the structured log — real links a developer can open.
# Swap in SMTP/Resend/etc. here for production.
EMAIL_PROVIDER=log

# ─── Rate limiting ─────────────────────────────────────────────────────────
# "postgres" shares counters across API processes and survives restarts
# (rate_limits table). "memory" keeps the old per-process counters — faster,
# but advisory: restarting the API resets every limit.
RATE_LIMIT_STORE=postgres
